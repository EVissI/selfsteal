# Корневой домен (зона в Cloudflare)
ROOT_DOMAIN=example.com
# Хост, который будет SNI/serverName в Reality (A-запись на IP ноды, DNS only)
SNI_HOST=at.example.com
# Токен Cloudflare: Zone -> DNS -> Edit, только для этой зоны
CF_API_TOKEN=
LE_EMAIL=you@example.com
# Локальный порт nginx (Reality dest). Менять не обязательно
NGINX_PORT=9443
