# Хост-заглушка: A-запись -> IP ноды, DNS only (серое облако).
# Это же значение идёт в serverNames/serverName Reality.
SNI_HOST=at.example.com
# Email для Let's Encrypt (уведомления об истечении сертификата)
LE_EMAIL=you@example.com
# Локальный порт nginx (Reality dest). Менять не обязательно
NGINX_PORT=9443
# Какой сайт-заглушку показывать: номер каталога в ./sites (1, 2, ...) или random.
# random выбирает случайный каталог при каждом старте контейнера.
SITE_INDEX=1
